{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/clean_chars.sh\"",
            "timeout": 30,
            "statusMessage": "Cleaning edited text files"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/verify_repo.sh\"",
            "timeout": 900,
            "statusMessage": "Running repository verification"
          }
        ]
      }
    ]
  }
}
